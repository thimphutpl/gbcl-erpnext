 "css": "    \r\n        body {\r\n            font-family: sans-serif;\r\n            margin: 20px;\r\n            padding: 20px;\r\n        }\r\n        table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n        }\r\n        \r\n        td, th {\r\n            border: 1px solid #000;\r\n            padding: 8px;\r\n            text-align: left;\r\n            font-size: 12px;\r\n        }\r\n        .main-table {\r\n            border: 1px solid #000;\r\n        }\r\n        .header-cell {\r\n            /*text-align: center;*/\r\n            /*vertical-align: top;*/\r\n            padding: 0;\r\n            border: none;\r\n        }\r\n        .logo-container {\r\n            text-align: center;\r\n            padding: 10px;\r\n        }\r\n        .logo-container img {\r\n            max-width: 100px;\r\n        }\r\n        .title-cell {\r\n            font-size: 20px;\r\n            font-weight: bold;\r\n            text-align: center;\r\n            padding-top: 20px;\r\n            vertical-align: top;\r\n        }\r\n        .details-label {\r\n            font-weight: bold;\r\n            background-color: #f2f2f2;\r\n            width: 15%;\r\n        }\r\n        .details-value {\r\n            width: 20%;\r\n        }\r\n        .requisition-header {\r\n            background-color: #007bff;\r\n            color: white;\r\n            text-align: center;\r\n            font-weight: bold;\r\n            padding: 10px;\r\n        }\r\n        .requisition-subheader th {\r\n            background-color: #007bff;\r\n            color: white;\r\n            text-align: center;\r\n            font-size: 12px;\r\n            padding: 10px;\r\n        }\r\n        .requisition-item-row td {\r\n            height: 30px;\r\n        }\r\n        .approval-cell {\r\n            vertical-align: top;\r\n            padding: 10px;\r\n        }\r\n        .approval-cell-half {\r\n            width: 50%;\r\n        }\r\n        .signature-line {\r\n            border-bottom: 1px solid #000;\r\n            margin-top: 5px;\r\n            height: 1px;\r\n        }\r\n        .signature-label {\r\n            font-weight: bold;\r\n            margin-bottom: 5px;\r\n        }\r\n\r\n    ",
