 "html": "<div>\r\n    <div id=\"header-html\" class=\"hidden-pdf\">\r\n\t\t{%- if letter_head and not no_letterhead -%}\r\n\t\t<div class=\"letter-head\">\r\n\t\t\t{{ letter_head }}\r\n\t\t</div>\r\n\t\t{%- endif -%}\r\n    </div>\r\n    <body>\r\n\r\n        <table class=\"main-table\">\r\n        \r\n            <!-- Header Row -->\r\n            <tr> <!-- Adjust row height as needed -->\r\n            <!-- Left column: Logo and company name -->\r\n            <td class=\"header-cell\" style=\"width: 50%; text-align: center; vertical-align: middle; border-right: 2px solid #000;\">\r\n                <div style=\"display: flex; flex-direction: column; align-items: center;\">\r\n                    <img src=\"https://gmc.bt/logo.svg\" alt=\"Gelephu Mindfulness City Logo\" style=\"max-width: 150px; margin-bottom: 10px;\"> <!-- bigger image -->\r\n                    <span style=\"font-weight: bold; font-size: 16px;\">{{ company_name or \"Gelephu Mindfulness City\" }}</span>\r\n                </div>\r\n            </td>\r\n            <td colspan=\"1\" style=\"height: 60px;\">\r\n                <div style=\"display: flex; justify-content: center; align-items: center; height: 100%;\">\r\n                </div>\r\n            </td>\r\n            <td colspan=\"4\" style=\"height: 60px;\">\r\n                <div style=\"display: flex; justify-content: center; align-items: center; height: 100%;\">\r\n                    <p  style=\"font-size:16px;font-weight:bold;\">\r\n                            {{ document_title or \"PURCHASE ORDER\" }}\r\n                        \r\n                    </p>\r\n                </div>\r\n               \r\n                \r\n                \r\n                \r\n             \r\n            </td>\r\n            </tr>\r\n        \r\n        \r\n        \r\n        \r\n            <!-- Details Rows -->\r\n            <tr>\r\n                <td class=\"details-label\">PO. No:</td>\r\n                <td class=\"details-value\">{{ department or \"\" }}</td>\r\n                <td class=\"details-label\"></td>\r\n                <td class=\"details-value\"></td>\r\n                <td class=\"details-label\"></td>\r\n                <td class=\"details-value\"></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"details-label\">PO. Date:</td>\r\n                <td class=\"details-value\">{{ section or \"\" }}</td>\r\n                <td class=\"details-label\"></td>\r\n                <td class=\"details-value\"></td>\r\n                <td class=\"details-label\"></td>\r\n                <td class=\"details-value\"></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"details-label\">Delivery Date:</td>\r\n                <td class=\"details-value\">{{ cost_center or \"\" }}</td>\r\n                <td class=\"details-label\"></td>\r\n                <td class=\"details-value\"></td>\r\n                <td class=\"details-label\"></td>\r\n                <td class=\"details-value\"></td>\r\n            </tr>\r\n        \r\n            <tr class=\"requisition-subheader\">\r\n                <th>VENDOR</th>\r\n                <th></th>\r\n                <th></th>\r\n                <th></th>\r\n                <th>Delivery place</th>\r\n                <th></th>\r\n            </tr>\r\n            <tr>\r\n                <th>Company: {{doc.company}}</th>\r\n                <th></th>\r\n                <th></th>\r\n                <th></th>\r\n                <th>Name</th>\r\n                <th></th>\r\n            </tr>\r\n            <tr>\r\n                <th>Branch:{{doc.branch}}</th>\r\n                <th></th>\r\n                <th></th>\r\n                <th></th>\r\n                <th>Company:{{doc.company}}</th>\r\n                <th></th>\r\n            </tr>\r\n            <tr>\r\n                <th>Address</th>\r\n                <th></th>\r\n                <th></th>\r\n                <th></th>\r\n                <th>Address:</th>\r\n                <th></th>\r\n            </tr>\r\n            <tr>\r\n                <th>Phone No.</th>\r\n                <th></th>\r\n                <th></th>\r\n                <th></th>\r\n                <th>Phone No:</th>\r\n                <th></th>\r\n            </tr>\r\n            <tr>\r\n                <th>Email</th>\r\n                <th></th>\r\n                <th></th>\r\n                <th></th>\r\n                <th>Email:</th>\r\n                <th></th>\r\n            </tr>\r\n        \r\n        \r\n            <tr class=\"requisition-subheader\">\r\n            <th>ITEMS</th>\r\n            <th></th>\r\n            <th>DESCRIPTION</th>\r\n            <th>QTY</th>\r\n            <th>UNIT PRICE</th>\r\n            <th>TOTAL PRICE</th>\r\n            </tr>\r\n        \r\n            {% for row in doc.items %}\r\n            <tr>\r\n                <td>{{ row.item_code }}</td>\r\n                <td></td>\r\n                <td>{{ row.description }}</td>\r\n                <td>{{ row.qty }}</td>\r\n                <td>{{ row.rate }}</td>\r\n                <td>{{ row.amount }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        \r\n            <!-- Approval Rows -->\r\n            <tr>\r\n            <td colspan=\"4\" rowspan=\"2\">\r\n                <div class=\"signature-label\">Comments or Special Instruction</div>\r\n            </td>\r\n                <td>Subtotal</td>\r\n                <td></td>\r\n            </tr>\r\n            <tr>\r\n                <td>Tax</td>\r\n                <td></td>\r\n            </tr>\r\n        \r\n            <tr>\r\n                <td class=\"approval-cell\">Approved by Procurement Office</br> (Name) & Date:</td>\r\n                <td class=\"approval-cell\"></td>\r\n                <td class=\"approval-cell\"></td>\r\n                <td class=\"approval-cell\"></td>\r\n                <td class=\"approval-cell\">Others</td>\r\n                <td class=\"approval-cell\"></td>\r\n                \r\n            </tr>\r\n            \r\n            <tr>\r\n                <td class=\"approval-cell\">Signature</td>\r\n                <td class=\"approval-cell\"></td>\r\n                <td class=\"approval-cell\"></td>\r\n                <td class=\"approval-cell\"></td>\r\n                <td class=\"approval-cell\">Total</td>\r\n                <td class=\"approval-cell\"></td>\r\n                \r\n            </tr>\r\n            <tr>\r\n          <td colspan=\"6\" class=\"approval-cell\">\r\n            If you have any questions about this purchase order, please contact (Name, Phone, Email)\r\n          </td>\r\n        </tr>\r\n        \r\n        \r\n        </table>\r\n\r\n    </body>\r\n</div>",
