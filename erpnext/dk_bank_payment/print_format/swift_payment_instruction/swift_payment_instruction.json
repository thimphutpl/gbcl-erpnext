 "html": "<div style=\"font-family: Arial, sans-serif; padding:5px;\">\r\n    <img src=\"/files/GMC_Letter_Head.png\" alt=\"GMC\" style=\"display: block;\">\r\n    <h2 style=\"text-align: center; color: green; font-weight: normal;\">\r\n        SWIFT Payment Instruction\r\n    </h2>\r\n    <hr style=\"width: 40%; margin: 10px auto;\">\r\n    <table style=\"width: 100%; border-collapse: collapse; border: none;\">\r\n        <tbody>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Name</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.name1 }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Phone Number</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.phone_number }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Permanent Address</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.permanent_address or '' }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Present Address</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.present_address or '' }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Account Number</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.account_number }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">National ID</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.national_id }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Email</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.email }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Account Source</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.account_source or '' }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Beneficiary Bank Name</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.beneficiary_bank_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Beneficiary Bank Address</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.beneficiary_bank_address }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Beneficiary Bank SWIFT Code</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.beneficiary_bank_swift_code }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Beneficiary Name</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.beneficiary_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Beneficiary Address</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.beneficiary_address }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Beneficiary Account No</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.beneficiary_account_no }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Amount in {{doc.amount_currency}}</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.amount_in_usd }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Amount in Words</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.amount_in_word }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Intermediary Bank Name</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.intermediary_bank_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Intermediary Bank Address</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.intermediary_bank_address }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Intermediary Bank SWIFT Code</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.intermediary_bank_swift_code }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Charges Debited From</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.charges_to_debited_from }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Charges Currency</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.charges_currency }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Reason</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.reason }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">BTFN Application Ref</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.btfn_application_reference_number }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Type of Payment</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.type_of_payment }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Customer Declaration No</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.customer_declaration_number }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Bank Remittance Ref No</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.bank_application_remittance_reference_number }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Commission Debit A/C No</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.commission_debit_account_number }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">Form Data</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.form_data }}</td>\r\n            </tr>\r\n            <tr>\r\n                <td style=\"padding: 8px; color: green;\">GMC Company</td>\r\n                <td style=\"padding: 8px; color: green;\">{{ doc.company }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n</div>\r\n",
